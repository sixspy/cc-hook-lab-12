{
  "名称": "停用联拒灌队样例",
  "说明": "事故夹具：端点名册已停用 ep-legacy，仍把事件灌入队。用于先造事故，再验停用联拒。",
  "端点键": "ep-legacy",
  "事件": [
    {
      "事件类型": "invoice.paid",
      "端点键": "ep-legacy",
      "载荷摘要": "stop=legacy-1",
      "优先级": "紧急"
    },
    {
      "事件类型": "user.created",
      "端点键": "ep-legacy",
      "载荷摘要": "stop=legacy-2",
      "优先级": "普通"
    },
    {
      "事件类型": "order.refund",
      "端点键": "ep-legacy",
      "载荷摘要": "stop=legacy-3",
      "优先级": "低"
    }
  ]
}
